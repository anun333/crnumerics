prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: crlin
Description: Verified linear systems: enclosures of the exact solution of A x = b, binary64, with no rounding-mode switching
Version: @VERSION@
URL: https://github.com/anun333/crnumerics
Cflags: -I${includedir}
Libs: -L${libdir} -lcrlin
Libs.private: -lm
