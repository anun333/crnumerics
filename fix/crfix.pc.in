prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: crfix
Description: Correctly rounded fixed-point functions (exp, log, sigmoid, tanh, sqrt, rsqrt, division) in integer arithmetic only
Version: @VERSION@
URL: https://github.com/anun333/crnumerics
Cflags: -I${includedir}
Libs: -L${libdir} -lcrfix
